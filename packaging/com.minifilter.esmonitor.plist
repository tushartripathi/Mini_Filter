<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Prefer: ./run_esmonitor.sh --install
     LaunchDaemon = root, system domain. Do not use a LaunchAgent. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minifilter.esmonitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/MiniFilter/MiniFilter</string>
        <string>--esmonitor</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>UserName</key>
    <string>root</string>
    <key>StandardOutPath</key>
    <string>/Library/Logs/MiniFilter/esmonitor.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/MiniFilter/esmonitor.stderr.log</string>
</dict>
</plist>
